# Functions HTTP base including /api (no trailing slash)
# Example: https://<func-app>.azurewebsites.net/api
NEXT_PUBLIC_FUNCTIONS_BASE_URL=

# Optional server-only override (preferred for non-public bases)
# FUNCTIONS_BASE_URL=

# Function key — keep server-side. Used by /api/functions/[...path] proxy.
FUNCTIONS_KEY=

# Fallbacks (avoid NEXT_PUBLIC_* for secrets in production)
# AZURE_FUNCTIONS_KEY=

# --- Auth.js + Microsoft Entra ID (single-tenant) ---
# Generate: openssl rand -base64 32
AUTH_SECRET=

# Entra app registration (Application / Directory IDs + client secret value)
AUTH_MICROSOFT_ENTRA_ID_APP_CLIENT_ID=
AUTH_MICROSOFT_ENTRA_ID_DIRECTORY_TENANT_ID=
AUTH_MICROSOFT_ENTRA_ID_CLIENT_SECRET_VALUE=

# Optional Entra secret metadata (not used by the app; portal/ops only)
# AUTH_MICROSOFT_ENTRA_ID_CLIENT_SECRET_ID=

# Public site URL Auth.js uses for OAuth redirect_uri (no trailing slash).
# REQUIRED on Azure App Service — without it Auth.js may infer the internal
# container hostname (e.g. https://<hash>:8080) and Entra returns AADSTS50011.
# Local:
AUTH_URL=http://localhost:3000
# Azure App Service (set the real public hostname in App settings):
# AUTH_URL=https://<app>.azurewebsites.net
