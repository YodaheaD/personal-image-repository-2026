# Functions HTTP base including /api (no trailing slash)
# Example: https://<func-app>.azurewebsites.net/api
NEXT_PUBLIC_FUNCTIONS_BASE_URL=

# Optional server-only override (preferred for non-public bases)
# FUNCTIONS_BASE_URL=

# Function key — keep server-side. Used by /api/functions/[...path] proxy.
FUNCTIONS_KEY=

# Fallbacks (avoid NEXT_PUBLIC_* for secrets in production)
# AZURE_FUNCTIONS_KEY=
